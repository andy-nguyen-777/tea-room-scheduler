// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Learning Prisma and its interactions:
model Room {
  // Every room receives a unique ID, cuid - Custome User ID
  id          String   @id @default(cuid())

  name        String
  description String
  capacity    Int
  hourlyRate  Float
  bookings    Booking[]
  
  // Create a stamp when a row was created in the database: helpful for sorting/debugging
  createdAt   DateTime @default(now())
}

model User {
  id        String    @id @default(cuid())
  name      String

  // Guarantees no two users can share an email
  email     String    @unique

  // 8/30: Added login password
  password String

  // Initializes role based access control (RBAC) between "customer" and "admin"
  role      String    @default("customer")

  // Initializes an array to sort through all of a user's bookings
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Booking {
  id             String   @id @default(cuid())

  // Links tables together: A Booking should belong to one Room and User
  room           Room     @relation(fields: [roomId], references: [id]) 
  roomId         String
  user           User     @relation(fields: [userId], references: [id])
  userId         String

  startTime      DateTime
  endTime        DateTime
  partySize      Int

  // Three valid statuses: pending, confirmed, cancelled
  status         String   @default("pending") 

  // LEARNED: ending with ? allows the field to be optional
  specialRequests String?
  createdAt      DateTime @default(now())
}